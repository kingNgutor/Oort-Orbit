; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Oort Orbit"
config/tags=PackedStringArray("3d", "demo", "physics")
run/main_scene="res://UI/custom_splash/custom_splash.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/stretch_mode=0
boot_splash/image="res://utilities/icons/oortOrbit_splashScreen_small.png"
config/icon="res://utilities/icons/tiny_logo_oortorbit.svg"
boot_splash/minimum_display_time=250

[audio]

buses/default_bus_layout="uid://btt3hchkxtxcq"

[autoload]

GlobalAutoload="*res://autoload/global_autoload.gd"
GlobalSignal="*res://autoload/global_signal.gd"
GlobalLoadmanager="*res://autoload/global_loadmanager.gd"
GlobalScenepath="*res://autoload/global_scenepath.gd"
GameState="*res://autoload/game_state.gd"
HighScore="*res://config/highscore.gd"
GlobalObjectPool="*res://stages/pooled_asteroid/objpool-experimental/Elektra-objectPool.tscn"
GlobalAudio="*res://autoload/global_audio.gd"
GlobalWorldOrigin="*uid://bpkhjiarvhxmj"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="C:\\Users\\NKST HIGH-LEVEL MKD\\Documents\\godot\\OortOrbit-[CLONE]-[ANDROID-BUILD]\\debuglog\\gd-oo-console_output.log"

[display]

window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/vsync/vsync_mode=2

[editor]

movie_writer/movie_file="C:\\Users\\NKST HIGH-LEVEL MKD\\Documents\\godot\\OortOrbit-[CLONE]-[ANDROID-BUILD]\\Oort-Orbit\\entities\\player_spaceship\\bakedVFX\\jetFlame.avi"
version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

