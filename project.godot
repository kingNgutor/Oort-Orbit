[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gyroscope=true

[layer_names]

3d_physics/layer_2="projectile"
3d_physics/layer_3="characterbody"

[physics]

3d/run_on_separate_thread=true
common/physics_jitter_fix=1.0
3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/temporary_memory_buffer_size=64
3d/solver/solver_iterations=8
common/physics_interpolation=true

[rendering]

driver/threads/thread_model=0
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=1
